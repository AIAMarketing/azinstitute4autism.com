---
import BaseLayout from './BaseLayout.astro';
import LikeViewCounter from '../components/LikeViewCounter.astro';
import ConsultationCTA from '../components/ConsultationCTA.astro';
const { entry } = Astro.props;
---
<BaseLayout title={entry.data.title} description={entry.data.description} canonical={entry.data.canonical} image={entry.data.featuredImage} lang={entry.data.lang} type="article">
  <article class="blog-post">
    <header class="article-header container-narrow">
      <p class="eyebrow">{entry.data.category || 'Library'}</p>
      <h1>{entry.data.title}</h1>
      <p class="lede">{entry.data.description}</p>
      <p><time datetime={entry.data.date.toISOString()}>{entry.data.date.toLocaleDateString(entry.data.lang)}</time></p>
      {entry.data.featuredImage && <img src={entry.data.featuredImage} alt={entry.data.alt || ''} />}
    </header>
    <div class="prose container-narrow"><slot /></div>
    <div class="container-narrow"><LikeViewCounter slug={entry.data.slug} /></div>
  </article>
  <ConsultationCTA />
</BaseLayout>
