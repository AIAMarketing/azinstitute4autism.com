---
import type { LogosSection } from '../../types/home-sections';
interface Props { section: LogosSection }
const { section } = Astro.props;
---
<div class="section home-logos">
  <div class="container logo-grid">
    {section.items.map(({ file, alt }) => (
      <img src={`/assets/images/${file}`} {alt} loading="lazy" />
    ))}
  </div>
</div>

<style>
  .logo-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-lg); align-items: center; }
  .logo-grid img { max-width: 100%; height: auto; justify-self: center; }
  @media (max-width: 760px) {
    .logo-grid { grid-template-columns: minmax(0, 1fr); }
  }
</style>
