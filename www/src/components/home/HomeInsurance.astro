---
import InsuranceLogoRow from '../InsuranceLogoRow.astro';
import type { InsuranceSection } from '../../types/home-sections';
interface Props { section: InsuranceSection }
const { section } = Astro.props;
---
<style>
  .insurance-logo-row-wrap {
    margin-top: 2rem;
  }
</style>

<section class="section insurance-section">
  <div class="container">
    <h2>{section.heading}</h2>
    <p>{section.body}</p>
    <div class="insurance-logo-row-wrap">
      <InsuranceLogoRow logos={section.logos} />
    </div>
  </div>
</section>
