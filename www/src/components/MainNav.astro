---
import en from '../data/navigation.en.json';
import es from '../data/navigation.es.json';
import ar from '../data/navigation.ar.json';
import { fallbackLabel, resolveNavigationDestination, type VisitorLocale, type VisitorPublication } from '../utils/visitor-navigation';
interface Props { lang?: VisitorLocale; manifest: VisitorPublication[]; }
const { lang = 'en', manifest } = Astro.props;
const nav = { en, es, ar }[lang];
const aboutLinks = lang === 'es'
  ? [['Equipo', '/team'], ['Carreras', '/careers'], ['Preguntas frecuentes', '/faqs']]
  : [['Team', '/team'], ['Careers', '/careers'], ['FAQ', '/faqs']];
const resolve = (item: { label: string; href: string }) => {
  const destination = resolveNavigationDestination(item.href, lang, manifest);
  return destination ? { ...item, ...destination } : null;
};
const primary = nav.primary.map(resolve).filter((item) => item !== null);
const services = nav.services.map(resolve).filter((item) => item !== null);
const about = aboutLinks.map(([label, href]) => resolve({ label, href })).filter((item) => item !== null);
const navLabel = { en: 'Main navigation', es: 'Navegación principal', ar: 'التنقل الرئيسي' }[lang];
---
<nav class="main-nav" aria-label={navLabel}>
  <ul>
    {primary.map((item) => (
      <li class:list={{ 'has-submenu': item.href.endsWith('/about') || item.href.endsWith('/services') }}>
        <a href={item.href} hreflang={item.fallback ? item.lang : undefined} aria-label={item.fallback ? `${item.label} — ${fallbackLabel(item.lang)}` : undefined}>
          {item.label}{item.fallback && <bdi class="nav-fallback" lang={item.lang}>{fallbackLabel(item.lang)}</bdi>}
        </a>
        {item.href.endsWith('/about') && about.length > 0 && <ul class="submenu">
          {about.map((link) => <li><a href={link.href} hreflang={link.fallback ? link.lang : undefined} aria-label={link.fallback ? `${link.label} — ${fallbackLabel(link.lang)}` : undefined}>{link.label}{link.fallback && <bdi class="nav-fallback" lang={link.lang}>{fallbackLabel(link.lang)}</bdi>}</a></li>)}
        </ul>}
        {item.href.endsWith('/services') && services.length > 0 && <ul class="submenu">
          {services.map((service) => <li><a href={service.href} hreflang={service.fallback ? service.lang : undefined} aria-label={service.fallback ? `${service.label} — ${fallbackLabel(service.lang)}` : undefined}>{service.label}{service.fallback && <bdi class="nav-fallback" lang={service.lang}>{fallbackLabel(service.lang)}</bdi>}</a></li>)}
        </ul>}
      </li>
    ))}
  </ul>
</nav>
<style>
  .main-nav { margin-inline: auto; }
  .main-nav ul { display: flex; gap: 1.4rem; list-style: none; margin: 0; padding: 0; }
  .main-nav li { position: relative; }
  .main-nav a { color: var(--color-primary); font-size: .9rem; text-decoration: none; }
  .main-nav a:hover { color: var(--color-accent-strong); }
  .nav-fallback { border: 1px solid currentColor; border-radius: 2px; font-size: .58rem; line-height: 1; margin-inline-start: .35rem; padding: .1rem .2rem; text-transform: uppercase; }
  .main-nav .submenu { background: white; box-shadow: var(--shadow-md); display: none; gap: 0; inset-inline-start: -1rem; min-width: 180px; padding: .75rem 0; position: absolute; top: 100%; }
  .main-nav .submenu a { display: block; padding: .45rem 1rem; }
  .main-nav li:hover > .submenu, .main-nav li:focus-within > .submenu { display: block; }
  .main-nav a:focus-visible { outline: 3px solid var(--color-accent); outline-offset: 3px; }
  @media (max-width: 950px) {
    .main-nav { display: none; }
    :global(.mobile-nav) .main-nav { display: block; }
    :global(.mobile-nav) .main-nav ul { align-items: flex-start; flex-direction: column; padding: var(--space-md); }
  }
</style>
