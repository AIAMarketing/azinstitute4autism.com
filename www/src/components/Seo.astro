---
import { allowIndexing } from '../utils/publication';
import { hreflangLinksFor, robotsFor, type TranslatedPublication } from '../utils/publication-policy';
import { socialImageUrl } from '../utils/seo';
import site from '../data/site.json';
interface Props {
  title: string;
  description?: string;
  publication: TranslatedPublication;
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article';
}
const {
  title,
  description = '',
  publication,
  image,
  imageAlt,
  type = 'website'
} = Astro.props;
const { canonical } = publication;
const absoluteImage = socialImageUrl(image, site.url);
const imageDescription = absoluteImage && imageAlt?.trim() ? imageAlt : undefined;
---
<title>{title}</title>
<meta name="description" content={description} />
<meta name="robots" content={robotsFor(publication, allowIndexing)} />
<link rel="canonical" href={canonical} />
{hreflangLinksFor(publication, allowIndexing).map(({ lang, href }) => <link rel="alternate" hreflang={lang} href={href} />)}
<meta property="og:type" content={type} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
{absoluteImage && <meta property="og:image" content={absoluteImage} />}
{imageDescription && <meta property="og:image:alt" content={imageDescription} />}
<meta name="twitter:card" content={absoluteImage ? 'summary_large_image' : 'summary'} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
{absoluteImage && <meta name="twitter:image" content={absoluteImage} />}
{imageDescription && <meta name="twitter:image:alt" content={imageDescription} />}
