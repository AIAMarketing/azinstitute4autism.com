---
import { allowIndexing } from '../utils/publication';
import { hreflangLinksFor, robotsFor, type TranslatedPublication } from '../utils/publication-policy';
interface Props {
  title: string;
  description?: string;
  publication: TranslatedPublication;
  image?: string;
  lang?: string;
  type?: 'website' | 'article';
}
const {
  title,
  description = '',
  publication,
  image,
  lang = 'en',
  type = 'website'
} = Astro.props;
const { canonical } = publication;
const absoluteImage = image ? new URL(image, Astro.site ?? Astro.url).href : undefined;
---
<title>{title}</title>
<meta name="description" content={description} />
<meta name="robots" content={robotsFor(publication, allowIndexing)} />
<link rel="canonical" href={canonical} />
{hreflangLinksFor(publication, allowIndexing).map(({ lang, href }) => <link rel="alternate" hreflang={lang} href={href} />)}
<meta property="og:type" content={type} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
{absoluteImage && <meta property="og:image" content={absoluteImage} />}
<meta name="twitter:card" content={absoluteImage ? 'summary_large_image' : 'summary'} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta property="og:locale" content={lang} />
