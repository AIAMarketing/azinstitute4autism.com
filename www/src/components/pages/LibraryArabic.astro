---
import { getLibraryCatalog } from '../../utils/library';
import { paginateLibraryItems } from '../../utils/library-pagination';
import BlogIndexLayout from '../../layouts/BlogIndexLayout.astro';
import BlogCard from '../BlogCard.astro';
import LibrarySearch from '../LibrarySearch.astro';
import LibraryPagination from '../LibraryPagination.astro';
interface Props { page?: number; }
const { page = 1 } = Astro.props;
const allPosts = (await getLibraryCatalog()).byLocale.ar;
const pagination = paginateLibraryItems(allPosts, page);
if (!pagination) throw new Error(`Invalid Arabic Library page: ${page}`);
const posts = pagination.items.map(({ entry }) => entry);
const popular = allPosts.slice(0, 5).map(({ entry }) => entry);
const heading = 'مكتبة معهد أريزونا للتوحد';
const title = page === 1 ? heading : `${heading} | الصفحة ${page}`;
---
<BlogIndexLayout title={title} heading={heading} description="مقالات إخبارية حول علاج تحليل السلوك التطبيقي والتعليم الخاص، ودراسات حالة، ووصفات، ومقالات افتتاحية، ودروس تعليمية." lang="ar">
  <div id="library-results-ar" class="library-search-results" hidden></div>
  <div id="library-archive-ar" class="library-archive">
    <div class="blog-list">{posts.map((post) => <BlogCard post={post} prefix="/ar" />)}</div>
    <LibraryPagination locale="ar" page={pagination} />
  </div>
  <aside class="library-sidebar"><LibrarySearch locale="ar" archiveId="library-archive-ar" resultsId="library-results-ar" /><h2>المقالات الشائعة</h2><ul>{popular.map((post) => <li><a href={`/ar/library/${post.data.slug}`}>{post.data.title}</a></li>)}</ul></aside>
</BlogIndexLayout>
